<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.wear.widget.BoxInsetLayout
        android:layout_height="match_parent"
        android:layout_width="match_parent">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/coordinator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_boxedEdges="all">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/browser_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/overlay_browser"
                layout="@layout/overlay_browser" />

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:id="@+id/preferences"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/colorBackground"
                android:visibility="gone" />

            <TextView
                android:id="@+id/build_text"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <com.hiddenramblings.tagmo.eightbit.widget.FABulous
                android:id="@+id/nfc_fab"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/fabDescription"
                app:fabSize="mini"
                app:useCompatPadding="false"
                app:layout_anchor="@+id/browser_pager"
                app:layout_anchorGravity="bottom|end"
                app:maxImageSize="40dp"
                app:srcCompat="@mipmap/ic_nfc_icon" />

            <com.hiddenramblings.tagmo.eightbit.view.AnimatedLinearLayout
                android:id="@+id/fake_snackbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorAccent"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_anchor="@+id/browser_pager"
                app:layout_anchorGravity="top">

                <TextView
                    android:id="@+id/snackbar_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="8dp"
                    android:textColor="@color/snackbarText"
                    android:textSize="12sp" />
            </com.hiddenramblings.tagmo.eightbit.view.AnimatedLinearLayout>

        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <LinearLayout
            android:id="@+id/wear_toolbar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_gravity="top"
            android:background="?attr/colorSurface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            app:layout_boxedEdges="all">

            <ImageButton
                android:id="@+id/wear_app_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/wear_app_drawer"
                android:padding="4dp"
                android:src="@drawable/ic_menu_24"
                android:tint="@android:color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/wear_content_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/wear_content_menu"
                android:padding="4dp"
                android:src="@drawable/ic_more_horiz_24"
                android:tint="@android:color/white" />

        </LinearLayout>
    </androidx.wear.widget.BoxInsetLayout>

</FrameLayout>
